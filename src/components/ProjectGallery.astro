---
import type { Project } from '../data/projects';
import { SERVICE_LABELS, getProjectImageUrl } from '../data/projects';

interface Props {
  projects: Project[];
  eyebrow?: string;
  heading?: string;
  intro?: string;
  /** Hide the service chip when the gallery is already context-scoped to one service. */
  showServiceChip?: boolean;
  /** Use the dark navy background instead of the slate-50 default. */
  variant?: 'light' | 'dark';
}

const {
  projects,
  eyebrow = 'Referenzen',
  heading = 'Unsere Arbeit.',
  intro,
  showServiceChip = true,
  variant = 'light',
} = Astro.props;

const hasProjects = projects.length > 0;
const isDark = variant === 'dark';
---

{hasProjects && (
  <>
    <section class:list={['px-6 md:px-24 py-16 md:py-24', isDark ? 'bg-[#0d1b2a] text-white' : 'bg-slate-50 text-[#0d1b2a]']}>
      <div class="flex items-end justify-between gap-6 mb-10 md:mb-14 flex-wrap">
        <div class="max-w-3xl">
          <p class="text-brand text-[10px] md:text-xs font-bold uppercase tracking-widest italic mb-3">{eyebrow}</p>
          <h2 class:list={['text-3xl md:text-5xl lg:text-6xl font-black uppercase leading-[0.95]', isDark ? 'text-white' : 'text-[#0d1b2a]']}>{heading}</h2>
          {intro && (
            <p class:list={['mt-5 md:mt-6 text-base md:text-lg font-medium leading-relaxed max-w-2xl', isDark ? 'text-slate-300' : 'text-slate-600']}>
              {intro}
            </p>
          )}
        </div>
        <p class:list={['hidden md:block text-[10px] font-bold uppercase tracking-widest', isDark ? 'text-slate-500' : 'text-slate-500']}>
          {projects.length} {projects.length === 1 ? 'Projekt' : 'Projekte'}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
        {projects.map((p) => {
          const cover = getProjectImageUrl(p, p.images[0]);
          return (
            <article class="group">
              <button
                type="button"
                data-project-trigger={p.slug}
                class="relative block w-full text-left aspect-[4/5] overflow-hidden bg-slate-200 cursor-pointer focus:outline-none focus-visible:ring-4 focus-visible:ring-brand transition-shadow"
                aria-haspopup="dialog"
                aria-controls={`project-dialog-${p.slug}`}
                aria-label={`Projekt ${p.title} öffnen – ${p.images.length} Foto${p.images.length === 1 ? '' : 's'}`}
              >
                <img
                  src={cover}
                  alt={`${p.title} – Attar Dienstleistungen in ${p.location ?? 'Kirn'}`}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover scale-100 group-hover:scale-110 transition-transform duration-700 ease-out"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0d1b2a]/95 via-[#0d1b2a]/30 to-transparent"></div>

                {showServiceChip && (
                  <span class="absolute top-4 left-4 inline-flex bg-brand text-white text-[9px] md:text-[10px] font-black uppercase tracking-widest px-3 py-1.5">
                    {SERVICE_LABELS[p.service]}
                  </span>
                )}
                <span class="absolute top-4 right-4 inline-flex items-center gap-1.5 bg-white/95 backdrop-blur-sm text-[#0d1b2a] text-[9px] md:text-[10px] font-black uppercase tracking-widest px-3 py-1.5">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
                    <path d="M4 5h10M4 5v14h16V8h-6L12 5"/>
                  </svg>
                  {p.images.length}
                </span>

                <div class="absolute bottom-0 left-0 right-0 p-5 md:p-7 text-white">
                  {(p.location || p.date) && (
                    <p class="text-brand text-[9px] md:text-[10px] font-bold uppercase tracking-widest mb-2">
                      {p.location}{p.location && p.date ? ' · ' : ''}{p.date}
                    </p>
                  )}
                  <h3 class="text-lg md:text-xl font-black uppercase italic leading-tight">{p.title}</h3>
                  <p class="mt-3 md:mt-4 text-[9px] md:text-[10px] font-bold uppercase tracking-widest text-brand inline-flex items-center gap-2 opacity-80 group-hover:opacity-100 transition-opacity">
                    Galerie öffnen
                    <span class="transition-transform group-hover:translate-x-1">→</span>
                  </p>
                </div>
              </button>
            </article>
          );
        })}
      </div>
    </section>

    {projects.map((p) => (
      <dialog
        id={`project-dialog-${p.slug}`}
        class="project-dialog"
        aria-labelledby={`project-dialog-title-${p.slug}`}
      >
        <div class="project-dialog-frame">
          <header class="sticky top-0 z-10 flex items-center justify-between gap-4 px-6 md:px-10 py-4 md:py-5 bg-white border-b border-slate-100">
            <div class="flex items-center gap-2 md:gap-3 flex-wrap">
              <span class="inline-flex bg-brand text-white text-[9px] font-black uppercase tracking-widest px-3 py-1.5">
                {SERVICE_LABELS[p.service]}
              </span>
              {(p.location || p.date) && (
                <span class="inline-flex border-2 border-[#0d1b2a] text-[#0d1b2a] text-[9px] font-black uppercase tracking-widest px-3 py-1.5">
                  {p.location}{p.location && p.date ? ' · ' : ''}{p.date}
                </span>
              )}
            </div>
            <button
              type="button"
              data-project-close
              class="p-2 -mr-2 text-[#0d1b2a] hover:text-brand transition-colors"
              aria-label="Galerie schließen"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
                <path d="M6 6L18 18M18 6L6 18"/>
              </svg>
            </button>
          </header>

          <div class="px-6 md:px-10 py-8 md:py-10">
            <h2 id={`project-dialog-title-${p.slug}`} class="text-2xl md:text-4xl lg:text-5xl font-black uppercase italic mb-4 md:mb-5 leading-[1.05] text-[#0d1b2a]">
              {p.title}
            </h2>
            <p class="text-sm md:text-base text-slate-600 font-medium leading-relaxed mb-8 md:mb-10 max-w-3xl">
              {p.description}
            </p>

            <div class={`swiper project-swiper-${p.slug} mb-6`}>
              <div class="swiper-wrapper">
                {p.images.map((file, idx) => (
                  <div class="swiper-slide">
                    <div class="aspect-[16/10] bg-slate-100 overflow-hidden">
                      <img
                        src={getProjectImageUrl(p, file)}
                        alt={`${p.title} – Foto ${idx + 1} von ${p.images.length}`}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover"
                      />
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="flex justify-between items-center gap-4">
              <div class="flex gap-2">
                <button
                  type="button"
                  data-project-prev={p.slug}
                  class="border-2 border-[#0d1b2a] p-3 hover:bg-[#0d1b2a] group transition-colors"
                  aria-label="Vorheriges Bild"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="stroke-[#0d1b2a] group-hover:stroke-white transition-colors" aria-hidden="true">
                    <path d="M19 12H5M5 12L11 6M5 12L11 18" stroke-width="3" stroke-linecap="square"/>
                  </svg>
                </button>
                <button
                  type="button"
                  data-project-next={p.slug}
                  class="border-2 border-[#0d1b2a] p-3 hover:bg-[#0d1b2a] group transition-colors"
                  aria-label="Nächstes Bild"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="stroke-[#0d1b2a] group-hover:stroke-white transition-colors" aria-hidden="true">
                    <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke-width="3" stroke-linecap="square"/>
                  </svg>
                </button>
              </div>
              <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">
                <span data-project-current={p.slug}>1</span> / {p.images.length}
              </p>
            </div>
          </div>
        </div>
      </dialog>
    ))}
  </>
)}

<script>
  import Swiper from 'swiper';
  import { Navigation, Keyboard } from 'swiper/modules';
  import 'swiper/css';

  const dialogs = document.querySelectorAll<HTMLDialogElement>('dialog.project-dialog');
  if (dialogs.length === 0) {
    /* No projects on this page — nothing to wire up. */
  } else {
    const swipers = new Map<string, Swiper>();

    dialogs.forEach((dialog) => {
      const slug = dialog.id.replace('project-dialog-', '');
      const swiperEl = dialog.querySelector<HTMLElement>(`.project-swiper-${slug}`);
      if (!swiperEl) return;

      const counter = dialog.querySelector<HTMLElement>(`[data-project-current="${slug}"]`);
      const total = swiperEl.querySelectorAll('.swiper-slide').length;
      const swiper = new Swiper(swiperEl, {
        modules: [Navigation, Keyboard],
        slidesPerView: 1,
        spaceBetween: 16,
        loop: total > 1,
        keyboard: { enabled: true, onlyInViewport: false },
        on: {
          slideChange(s) {
            if (counter) counter.textContent = String((s.realIndex ?? s.activeIndex) + 1);
          },
        },
      });
      swipers.set(slug, swiper);

      dialog.querySelector<HTMLButtonElement>(`[data-project-prev="${slug}"]`)?.addEventListener('click', () => swiper.slidePrev());
      dialog.querySelector<HTMLButtonElement>(`[data-project-next="${slug}"]`)?.addEventListener('click', () => swiper.slideNext());
      dialog.querySelector<HTMLButtonElement>('[data-project-close]')?.addEventListener('click', () => dialog.close());

      // Click backdrop to close
      dialog.addEventListener('click', (e) => {
        const rect = (dialog.firstElementChild as HTMLElement | null)?.getBoundingClientRect();
        if (!rect) return;
        const { clientX: x, clientY: y } = e;
        const inside = x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom;
        if (!inside) dialog.close();
      });

      dialog.addEventListener('close', () => {
        document.body.style.overflow = '';
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-project-trigger]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-project-trigger');
        if (!slug) return;
        const dialog = document.getElementById(`project-dialog-${slug}`) as HTMLDialogElement | null;
        if (!dialog) return;
        document.body.style.overflow = 'hidden';
        dialog.showModal();
        // Recompute after the dialog becomes visible.
        requestAnimationFrame(() => swipers.get(slug)?.update());
      });
    });
  }
</script>

<style>
  dialog.project-dialog {
    border: none;
    padding: 0;
    margin: 0;
    background: transparent;
    width: 100%;
    max-width: none;
    max-height: 100vh;
    overflow: visible;
  }
  dialog.project-dialog::backdrop {
    background-color: rgba(13, 27, 42, 0.85);
    backdrop-filter: blur(6px);
  }
  dialog.project-dialog .project-dialog-frame {
    background: #ffffff;
    width: calc(100% - 1.5rem);
    max-width: 72rem;
    margin: 1rem auto;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
  }
  @media (min-width: 768px) {
    dialog.project-dialog .project-dialog-frame {
      width: calc(100% - 4rem);
      margin: 2rem auto;
      max-height: calc(100vh - 4rem);
    }
  }
  dialog.project-dialog[open] {
    display: block;
    animation: project-dialog-in 0.25s ease-out;
  }
  @keyframes project-dialog-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    dialog.project-dialog[open] {
      animation: none;
    }
  }
</style>
