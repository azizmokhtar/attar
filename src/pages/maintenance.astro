---
// Maintenance screen — served for every route while the catch-all redirect in
// vercel.json is active. Returns HTTP 503 (Retry-After) so search engines treat
// the site as TEMPORARILY unavailable and do NOT deindex it.
// To bring the site back online: remove the "redirects" block in vercel.json
// (and optionally delete this file), then redeploy.
export const prerender = false;

Astro.response.status = 503;
Astro.response.headers.set('Retry-After', '86400');
Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Wartungsarbeiten – Attar Dienstleistungen</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0d1b2a;
        color: #fff;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        text-align: center;
        padding: 2rem;
        -webkit-font-smoothing: antialiased;
      }
      .wrap { max-width: 560px; }
      .bar { width: 64px; height: 6px; background: #ff5f00; margin: 0 auto 2rem; }
      .brand {
        font-size: 0.8rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: #ff5f00;
        font-weight: 700;
        font-style: italic;
        margin-bottom: 1.5rem;
      }
      h1 {
        font-size: clamp(2rem, 7vw, 3.5rem);
        font-weight: 900;
        text-transform: uppercase;
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin-bottom: 1.25rem;
      }
      p { color: #94a3b8; font-size: 1.05rem; line-height: 1.6; margin-bottom: 0.5rem; }
      .contact { margin-top: 2rem; font-size: 0.95rem; color: #cbd5e1; }
      a { color: #ff5f00; font-weight: 600; text-decoration: none; }
      a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="bar"></div>
      <p class="brand">Attar Dienstleistungen</p>
      <h1>Wir sind<br />bald wieder da.</h1>
      <p class="contact">
        Sie erreichen uns telefonisch unter<br />
        <a href="tel:+4917655235870">+49 176 55235870</a>
      </p>
    </div>
  </body>
</html>
