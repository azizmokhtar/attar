---
export const prerender = true;

import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import IndividualOfferCTA from '../../components/IndividualOfferCTA.astro';
import { getPublishedPosts, formatDate, isoDate, readingMinutes, postPath } from '../../data/blog';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const SITE_URL = 'https://attar-dienstleistungen.de';
const url = `${SITE_URL}${postPath(post)}`;
const minutes = readingMinutes(post.body);

// Related posts: same category first, then newest — max 3.
const all = await getPublishedPosts();
const related = all
  .filter((p) => p.id !== post.id)
  .sort((a, b) => Number(b.data.category === post.data.category) - Number(a.data.category === post.data.category))
  .slice(0, 3);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: post.data.title,
  description: post.data.description,
  inLanguage: 'de-DE',
  datePublished: isoDate(post.data.pubDate),
  dateModified: isoDate(post.data.updatedDate ?? post.data.pubDate),
  author: { '@type': 'Organization', name: post.data.author, '@id': `${SITE_URL}/#organization` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
  keywords: post.data.tags.join(', ') || undefined,
  ...(post.data.heroImage ? { image: new URL(post.data.heroImage.src, SITE_URL).href } : {}),
};

const faqLd = post.data.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: post.data.faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;

const jsonLd = faqLd ? [articleLd, faqLd] : articleLd;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  image={post.data.heroImage?.src ?? '/og-default.jpg'}
  canonical={url}
  breadcrumbs={[
    { name: 'Start', url: '/' },
    { name: 'Ratgeber', url: '/blog' },
    { name: post.data.title, url: postPath(post) },
  ]}
  jsonLd={jsonLd}
>
  <article>
    {/* Header */}
    <header class="pt-24 pb-8 md:pt-40 md:pb-12 px-6 md:px-24 max-w-4xl mx-auto">
      <a href="/blog" class="inline-flex items-center gap-2 text-brand font-bold uppercase tracking-widest text-[10px] md:text-xs italic mb-6 hover:text-[#0d1b2a] transition-colors">
        <span>←</span> Ratgeber
      </a>
      <p class="text-brand font-bold uppercase tracking-widest text-[9px] md:text-[10px] mb-4">
        {post.data.category}
      </p>
      <h1 class="text-[clamp(1.9rem,6vw,4rem)] font-black uppercase leading-[0.95] tracking-tighter mb-8 text-[#0d1b2a]">
        {post.data.title}
      </h1>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-bold uppercase tracking-widest text-slate-400">
        <span>{post.data.author}</span>
        <span class="text-slate-300">·</span>
        <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
        <span class="text-slate-300">·</span>
        <span>{minutes} Min. Lesezeit</span>
      </div>
    </header>

    {/* Hero image */}
    {post.data.heroImage && (
      <div class="px-6 md:px-24 max-w-5xl mx-auto mb-10 md:mb-16">
        <div class="overflow-hidden bg-slate-100 aspect-[16/9]">
          <Image
            src={post.data.heroImage}
            alt={post.data.heroImageAlt ?? post.data.title}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 1024px) 1024px, 100vw"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      </div>
    )}

    {/* Body */}
    <div class="px-6 md:px-24 pb-16 md:pb-24">
      <div class="prose-attar max-w-3xl mx-auto">
        <Content />
      </div>
    </div>

    {/* FAQ */}
    {post.data.faq.length > 0 && (
      <section class="px-6 md:px-24 py-16 md:py-24 bg-slate-50/50 border-y border-slate-100">
        <div class="max-w-3xl mx-auto">
          <p class="text-brand font-bold uppercase tracking-[0.3em] mb-4 text-[10px] md:text-xs italic">FAQ</p>
          <h2 class="text-2xl md:text-4xl font-black uppercase tracking-tighter leading-[0.95] mb-10 text-[#0d1b2a]">
            Häufige Fragen.
          </h2>
          <div class="divide-y divide-slate-200 border-t border-slate-200">
            {post.data.faq.map((f) => (
              <details class="group py-5">
                <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
                  <span class="text-base md:text-lg font-black text-[#0d1b2a] leading-snug">{f.question}</span>
                  <span class="text-brand text-2xl font-black leading-none shrink-0 transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-3 text-slate-600 font-medium leading-relaxed">{f.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* Tags */}
    {post.data.tags.length > 0 && (
      <div class="px-6 md:px-24 pt-12 max-w-3xl mx-auto">
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="text-[10px] font-bold uppercase tracking-widest text-slate-500 bg-slate-100 px-3 py-1.5">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    )}

    {/* Related posts */}
    {related.length > 0 && (
      <section class="px-6 md:px-24 py-16 md:py-24">
        <p class="text-brand font-bold uppercase tracking-[0.3em] mb-4 text-[10px] md:text-xs italic">Weiterlesen</p>
        <h2 class="text-2xl md:text-4xl font-black uppercase tracking-tighter leading-[0.95] mb-10 text-[#0d1b2a]">
          Mehr aus dem Ratgeber.
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-slate-100 border border-slate-100">
          {related.map((p) => (
            <a href={postPath(p)} class="group bg-white p-6 md:p-8 flex flex-col hover:bg-slate-50/50 transition-colors">
              <p class="text-brand font-bold uppercase tracking-widest text-[9px] mb-3">
                {p.data.category} · {readingMinutes(p.body)} Min.
              </p>
              <h3 class="text-lg font-black uppercase tracking-tight leading-[1.1] mb-3 text-[#0d1b2a] group-hover:text-brand transition-colors">
                {p.data.title}
              </h3>
              <span class="mt-auto inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-[#0d1b2a] group-hover:text-brand transition-colors">
                Lesen <span class="group-hover:translate-x-1 transition-transform">→</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>

  <IndividualOfferCTA />
</Layout>
