---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import IndividualOfferCTA from '../../components/IndividualOfferCTA.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import { getProjectsByService } from '../../data/projects';
import { Image } from 'astro:assets';
import heroImg from '../../assets/services/garten.jpg';

const projects = getProjectsByService('garten');

const SITE_URL = 'https://attardienstleistungen.com';
const PAGE_PATH = '/dienstleistungen/gartenservice';
const PAGE_URL = `${SITE_URL}${PAGE_PATH}`;

const included = [
  { h: 'Rasenpflege', p: 'Mähen, Vertikutieren, Düngen, Aerifizieren und Nachsaat. Wir bringen Ihren Rasen in Form und halten ihn das ganze Jahr in Topzustand.' },
  { h: 'Heckenschnitt & Formschnitt', p: 'Fachgerechter Rückschnitt von Hecken, Sträuchern und Formgehölzen. Inklusive Schnittgutentsorgung und Endreinigung der Flächen.' },
  { h: 'Baumpflege & Baumfällung', p: 'Pflegeschnitte, Auslichtung und auf Anfrage Fällung kleinerer Bäume. Größere Fällungen koordinieren wir mit zertifizierten Partnern.' },
  { h: 'Beet- und Staudenpflege', p: 'Anlage, Pflege und saisonale Bepflanzung von Beeten und Staudenflächen. Inklusive Unkrautentfernung, Mulchen und Düngung.' },
  { h: 'Laub- und Grünschnittentsorgung', p: 'Herbstdienst, Laubbeseitigung, Grünschnitt- und Wurzelentsorgung. Inklusive Abtransport und fachgerechter Entsorgung.' },
  { h: 'Außenanlagen & Wegepflege', p: 'Reinigung und Pflege von Pflasterflächen, Einfahrten, Hofbereichen und Zäunen. Inklusive Wildkrautbekämpfung ohne Glyphosat.' },
];

const process = [
  { n: '01', h: 'Bestandsaufnahme', p: 'Wir besichtigen Ihren Garten oder die Außenanlage, erfassen Flächen, Pflanzen und Zustand. Sie schildern Ihre Wünsche.' },
  { n: '02', h: 'Pflegeplan & Angebot', p: 'Sie erhalten einen jahreszeitlich strukturierten Pflegeplan mit Festpreisen pro Einsatz oder als pauschales Jahresangebot.' },
  { n: '03', h: 'Ausführung', p: 'Unser Team arbeitet mit professionellem Equipment, achtet auf Schnittzeiten und Naturschutz und hinterlässt die Fläche gepflegt und sauber.' },
  { n: '04', h: 'Nachsorge', p: 'Wir dokumentieren jeden Einsatz, beraten zu nächsten Schritten und passen den Pflegeplan an Wetter und Saison an.' },
];

const faqs = [
  {
    q: 'Welche Gartenarbeiten übernimmt Attar Dienstleistungen?',
    a: 'Wir übernehmen Rasenpflege, Hecken- und Formschnitt, Baum- und Staudenpflege, Beetanlage, Laubentsorgung, Wegepflege und Wildkrautbekämpfung. Auch saisonale Komplettpflege als Jahresvertrag ist möglich.',
  },
  {
    q: 'Pflegen Sie auch große Außenanlagen für Unternehmen?',
    a: 'Ja. Wir betreuen Außenanlagen von Wohnanlagen, Gewerbeobjekten, Praxen und Hotels in Kirn, Bad Kreuznach und Idar-Oberstein – inklusive regelmäßiger Sichtprüfung und dokumentierter Einsatznachweise.',
  },
  {
    q: 'Arbeiten Sie auch ohne chemische Pflanzenschutzmittel?',
    a: 'Ja. Wir arbeiten standardmäßig mechanisch und thermisch, ohne Glyphosat. Auf Wunsch beraten wir zu naturnaher und insektenfreundlicher Gartengestaltung.',
  },
  {
    q: 'Wann ist die beste Zeit für Heckenschnitt?',
    a: 'Form- und Erhaltungsschnitte sind nach § 39 BNatSchG zwischen dem 1. März und 30. September erlaubt. Radikale Rückschnitte führen wir im Winterhalbjahr durch. Wir achten in jedem Fall auf Brutzeiten und schützenswerte Pflanzen.',
  },
  {
    q: 'Was kostet die Gartenpflege in Kirn?',
    a: 'Einzelne Einsätze rechnen wir nach Aufwand und Fläche zum Festpreis ab. Für regelmäßige Pflege bieten wir Jahresverträge mit festen Monatsraten – kalkulierbar und ohne Stundenrisiko.',
  },
  {
    q: 'Wie oft sollte der Rasen gemäht werden?',
    a: 'In der Hauptwachstumszeit von April bis Oktober ist ein Schnitt alle ein bis zwei Wochen ideal. Wir übernehmen die Pflege nach festem Turnus oder bei Bedarf – passend zu Ihrer Außenanlage.',
  },
  {
    q: 'Übernehmen Sie auch Baumfällungen?',
    a: 'Kleinere Bäume fällen und entsorgen wir im Rahmen der Gartenpflege. Bei größeren Fällungen klären wir vorab Umfang und eventuell erforderliche Genehmigungen, da diese je nach Gemeinde und Baumschutzsatzung nötig sein können.',
  },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${PAGE_URL}#service`,
  name: 'Gartenservice Kirn',
  serviceType: 'GardeningService',
  category: 'Garten- und Landschaftspflege',
  description:
    'Gartenservice in Kirn, Bad Kreuznach und Idar-Oberstein: Rasenpflege, Hecken- und Baumschnitt, Beetpflege, Laub- und Grünschnittentsorgung sowie ganzjährige Pflege von Außenanlagen.',
  provider: { '@id': `${SITE_URL}/#organization` },
  areaServed: [
    { '@type': 'City', name: 'Kirn' },
    { '@type': 'City', name: 'Bad Kreuznach' },
    { '@type': 'City', name: 'Idar-Oberstein' },
    { '@type': 'City', name: 'Bad Sobernheim' },
    { '@type': 'AdministrativeArea', name: 'Rheinland-Pfalz' },
  ],
  url: PAGE_URL,
  image: new URL(heroImg.src, SITE_URL).href,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Gartenleistungen',
    itemListElement: included.map((i) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: i.h, description: i.p },
    })),
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${PAGE_URL}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Gartenservice in Kirn – Rasen, Hecke, Baumpflege & Grünschnitt"
  description="Professioneller Gartenservice in Kirn, Bad Kreuznach und Idar-Oberstein: Rasenpflege, Heckenschnitt, Baumpflege, Beetpflege, Laubentsorgung und ganzjährige Außenanlagenpflege. Festpreis, ohne Glyphosat, mit dokumentierten Einsätzen."
  image={heroImg.src}
  breadcrumbs={[
    { name: 'Start', url: '/' },
    { name: 'Dienstleistungen', url: '/dienstleistungen' },
    { name: 'Gartenservice', url: PAGE_PATH },
  ]}
  jsonLd={[serviceLd, faqLd]}
>
  <section class="pt-24 pb-12 md:pt-40 md:pb-20 px-6 md:px-24">
    <p class="text-brand font-bold uppercase tracking-[0.3em] mb-4 text-[10px] md:text-xs italic">Dienstleistung 04 · Gartenservice</p>
    <h1 class="text-[clamp(2rem,8vw,6.5rem)] font-black uppercase leading-[0.9] mb-6 md:mb-8 text-[#0d1b2a]">
      Gartenservice<br />
      <span class="stroke-dark">in Kirn & Umgebung.</span>
    </h1>
    <p class="text-lg md:text-2xl text-slate-600 font-medium leading-relaxed max-w-3xl">
      Gepflegte Außenanlagen für Privat- und Gewerbekunden in Kirn, Bad Kreuznach und Idar-Oberstein. Saubere Arbeit, naturnahe Pflege und ein klares Ergebnis – Saison für Saison.
    </p>
  </section>

  <section class="px-6 md:px-24 py-12 md:py-20 bg-slate-50 border-y border-slate-100">
    <div class="grid md:grid-cols-12 gap-8 md:gap-16">
      <div class="md:col-span-4">
        <p class="text-[10px] md:text-xs font-bold uppercase tracking-widest text-brand italic mb-2">Was Sie erhalten</p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-black uppercase leading-[0.95] text-[#0d1b2a]">Pflege mit System.</h2>
      </div>
      <div class="md:col-span-8 space-y-5 text-base md:text-lg text-slate-600 font-medium leading-relaxed max-w-3xl">
        <p>
          Ein gepflegter Garten entsteht nicht durch Zufall. Er ist Ergebnis kontinuierlicher Arbeit, fachlicher Sorgfalt und der richtigen Eingriffe zur richtigen Zeit. Als <strong class="text-[#0d1b2a]">Gartenservice in Kirn</strong> übernehmen wir die laufende Pflege Ihrer Außenanlagen – mit jahreszeitlich strukturierten Pflegeplänen und nachvollziehbaren Festpreisen.
        </p>
        <p>
          Wir betreuen Privatgärten, Vorgärten, Innenhöfe und gewerbliche Außenanlagen. Vom regelmäßigen Rasenschnitt über Hecken-, Form- und Baumschnitt bis zur saisonalen Beetbepflanzung, Laubentsorgung und Wegepflege. Wir arbeiten ohne Glyphosat, achten auf Brutzeiten und beraten Sie auch zu naturnaher, insektenfreundlicher Gestaltung.
        </p>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-24 py-16 md:py-24">
    <p class="text-[10px] md:text-xs font-bold uppercase tracking-widest text-brand italic mb-3">Leistungen im Detail</p>
    <h2 class="text-3xl md:text-5xl font-black uppercase mb-10 md:mb-14 text-[#0d1b2a] max-w-3xl">Diese Gartenarbeiten führen wir aus.</h2>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {included.map((i, idx) => (
        <div class="bg-white border border-slate-200 p-6 md:p-8 hover:border-brand transition-colors">
          <p class="text-brand font-black italic text-3xl md:text-4xl leading-none mb-4">0{idx + 1}</p>
          <h3 class="text-base md:text-lg font-black uppercase mb-3 text-[#0d1b2a] leading-tight">{i.h}</h3>
          <p class="text-sm text-slate-600 font-medium leading-relaxed">{i.p}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="px-6 md:px-24 py-16 md:py-24 bg-[#0d1b2a] text-white">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16">
      <div class="md:col-span-4">
        <p class="text-brand text-[10px] md:text-xs font-bold uppercase tracking-widest italic mb-3">Für wen</p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-black uppercase leading-[0.95]">Privat, Gewerbe, Verwaltung.</h2>
      </div>
      <div class="md:col-span-8 grid sm:grid-cols-2 gap-6 md:gap-8 text-slate-300">
        <div>
          <p class="text-brand font-black italic text-2xl mb-2 leading-none">Privatgärten</p>
          <p class="text-sm md:text-base font-medium leading-relaxed">Regelmäßige Pflege oder einmalige Aufräumaktionen, Frühlings- oder Herbstkur, Hecken in Form bringen, neue Beete anlegen.</p>
        </div>
        <div>
          <p class="text-brand font-black italic text-2xl mb-2 leading-none">Gewerbeobjekte</p>
          <p class="text-sm md:text-base font-medium leading-relaxed">Repräsentative Außenanlagen für Firmensitze, Praxen, Hotels und Filialen – inklusive Pflege der Eingangsbereiche.</p>
        </div>
        <div>
          <p class="text-brand font-black italic text-2xl mb-2 leading-none">WEG & Hausverwaltungen</p>
          <p class="text-sm md:text-base font-medium leading-relaxed">Vertraglich vereinbarte Pflege von Allgemeinflächen, Vorgärten, Mülleinhausungen und Innenhöfen mit klaren Einsatznachweisen.</p>
        </div>
        <div>
          <p class="text-brand font-black italic text-2xl mb-2 leading-none">Senioren & Vielreisende</p>
          <p class="text-sm md:text-base font-medium leading-relaxed">Wenn die Pflege selbst nicht mehr möglich ist oder Sie regelmäßig unterwegs sind: Wir übernehmen zuverlässig in Ihrer Abwesenheit.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-24 py-16 md:py-24">
    <p class="text-[10px] md:text-xs font-bold uppercase tracking-widest text-brand italic mb-3">Ablauf</p>
    <h2 class="text-3xl md:text-5xl font-black uppercase mb-10 md:mb-14 text-[#0d1b2a] max-w-3xl">So pflegen wir Ihren Garten.</h2>

    <div class="grid md:grid-cols-4 gap-8 md:gap-6 border-t border-slate-200 pt-10">
      {process.map((step) => (
        <div class="md:border-r md:last:border-r-0 md:border-slate-200 md:pr-6">
          <p class="text-brand font-black italic text-5xl md:text-6xl mb-4 leading-none">{step.n}</p>
          <h3 class="text-lg md:text-xl font-black uppercase mb-3 text-[#0d1b2a] leading-tight">{step.h}</h3>
          <p class="text-sm text-slate-600 font-medium leading-relaxed">{step.p}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="px-6 md:px-24 py-16 md:py-24 bg-slate-50">
    <div class="grid md:grid-cols-12 gap-8 md:gap-16">
      <div class="md:col-span-4">
        <p class="text-brand text-[10px] md:text-xs font-bold uppercase tracking-widest italic mb-3">Einsatzgebiet</p>
        <h2 class="text-3xl md:text-4xl font-black uppercase leading-[0.95] text-[#0d1b2a]">Wo wir pflegen.</h2>
      </div>
      <div class="md:col-span-8">
        <p class="text-base md:text-lg text-slate-600 font-medium leading-relaxed mb-6 max-w-2xl">
          Wir pflegen Gärten und Außenanlagen im Landkreis Bad Kreuznach und in angrenzenden Regionen. Größere Objekte betreuen wir auf Anfrage auch überregional.
        </p>
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs md:text-sm font-bold uppercase tracking-wider text-[#0d1b2a]">
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-brand rounded-full"></span>Kirn</li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-brand rounded-full"></span>Bad Kreuznach</li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-brand rounded-full"></span>Idar-Oberstein</li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-brand rounded-full"></span>Bad Sobernheim</li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-brand rounded-full"></span>Simmertal</li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-brand rounded-full"></span>Meisenheim</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-24 py-16 md:py-24">
    <p class="text-[10px] md:text-xs font-bold uppercase tracking-widest text-brand italic mb-3">Häufige Fragen</p>
    <h2 class="text-3xl md:text-5xl font-black uppercase mb-10 md:mb-14 text-[#0d1b2a] max-w-3xl">FAQ – Gartenservice.</h2>

    <div class="divide-y divide-slate-200 border-y border-slate-200 max-w-4xl">
      {faqs.map((f) => (
        <details class="group py-5 md:py-6">
          <summary class="flex justify-between items-center cursor-pointer list-none gap-6">
            <h3 class="text-base md:text-lg font-black uppercase text-[#0d1b2a] leading-snug">{f.q}</h3>
            <span class="text-brand font-black text-2xl shrink-0 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="text-sm md:text-base text-slate-600 font-medium leading-relaxed mt-4 max-w-3xl">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <ProjectGallery
    projects={projects}
    eyebrow="Referenzen"
    heading="Gartenprojekte."
    intro="Ausgewählte Gartenaufträge aus Kirn und Umgebung. Klicken Sie auf ein Projekt für die vollständige Fotostrecke."
    showServiceChip={false}
  />

  <IndividualOfferCTA />
</Layout>
