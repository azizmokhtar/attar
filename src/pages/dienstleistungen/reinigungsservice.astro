---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';

const SITE_URL = 'https://attar-dienstleistungen.de';
const PAGE_PATH = '/dienstleistungen/reinigungsservice';
const PAGE_URL = `${SITE_URL}${PAGE_PATH}`;

const included = [
  { h: 'Unterhaltsreinigung', p: 'Regelmäßige Pflege von Büro-, Praxis- und Gewerbeflächen nach festem Plan – Böden, Sanitäranlagen, Küchen, Glasflächen und Kontaktstellen.' },
  { h: 'Grundreinigung', p: 'Intensive Tiefenreinigung bei Bezug, Auszug oder nach Bauphasen. Inklusive Bodenbeschichtungen, Fugen, Heizkörpern und schwer zugänglichen Bereichen.' },
  { h: 'Bauschluss- und Bauendreinigung', p: 'Staub-, Mörtel- und Klebereste-Entfernung nach Sanierungen oder Neubauten. Übergabefertige Reinigung inklusive Fenster und Rahmen.' },
  { h: 'Treppenhausreinigung', p: 'Wiederkehrende Reinigung von Wohn- und Geschäftshäusern für Hausverwaltungen und WEG-Verwalter, inklusive Eingangsbereichen und Kellerwegen.' },
  { h: 'Glas- und Fensterreinigung', p: 'Streifenfreie Reinigung innen und außen, inklusive Rahmen und Fensterbänken. Mit Teleskoptechnik auch in größerer Höhe.' },
  { h: 'Sonderreinigung', p: 'Nikotin- und Geruchsentfernung, Endreinigung nach Wohnungsauflösungen, Reinigung nach Wasserschäden, Tatortreinigung auf Anfrage.' },
];

const process = [
  { n: '01', h: 'Anfrage & Begehung', p: 'Sie schildern uns Objekt, Fläche und Anforderungen. Bei größeren Aufträgen vereinbaren wir eine kostenlose Besichtigung vor Ort.' },
  { n: '02', h: 'Konzept & Angebot', p: 'Sie erhalten einen klaren Reinigungsplan mit Intervallen, eingesetzten Mitteln und einem transparenten Festpreis – ohne versteckte Posten.' },
  { n: '03', h: 'Durchführung', p: 'Unser Team arbeitet nach festgelegtem Reinigungsplan, mit professionellem Equipment und dokumentierten Qualitätskontrollen.' },
  { n: '04', h: 'Abnahme & Nachsorge', p: 'Sie prüfen das Ergebnis. Bei wiederkehrenden Aufträgen passen wir Frequenz oder Schwerpunkte jederzeit flexibel an.' },
];

const faqs = [
  {
    q: 'Welche Flächen reinigt Attar Dienstleistungen?',
    a: 'Wir reinigen Büros, Praxen, Kanzleien, Ladenflächen, Gewerbeimmobilien, Treppenhäuser, Wohnungen sowie Objekte nach Sanierung oder Auszug. Sonderreinigungen wie Bauschluss oder Geruchsentfernung führen wir ebenfalls aus.',
  },
  {
    q: 'In welchen Orten reinigen Sie?',
    a: 'Unser Einsatzgebiet umfasst Kirn, Bad Kreuznach, Idar-Oberstein, Bad Sobernheim sowie umliegende Gemeinden im Landkreis Bad Kreuznach. Größere Aufträge übernehmen wir auch außerhalb dieser Region.',
  },
  {
    q: 'Wie schnell können Sie mit der Reinigung beginnen?',
    a: 'Unterhaltsreinigungen starten meist innerhalb von 5 bis 7 Werktagen nach Auftragsbestätigung. Bauschluss- und Sonderreinigungen können in dringenden Fällen schneller eingetaktet werden – fragen Sie nach Express-Terminen.',
  },
  {
    q: 'Sind Reinigungsmittel und Geräte im Preis enthalten?',
    a: 'Ja. Wir bringen alle Reinigungsmittel, Maschinen und Verbrauchsmaterialien mit. Auf Wunsch arbeiten wir mit umweltzertifizierten Mitteln oder berücksichtigen besondere Anforderungen Ihres Objekts.',
  },
  {
    q: 'Was kostet eine professionelle Reinigung in Kirn?',
    a: 'Der Preis richtet sich nach Fläche, Verschmutzungsgrad, Intervall und Anfahrtsweg. Sie erhalten einen verbindlichen Festpreis nach Begehung oder Beschreibung des Objekts – ohne Stundenrisiko.',
  },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${PAGE_URL}#service`,
  name: 'Reinigungsservice Kirn',
  serviceType: 'CleaningService',
  category: 'Gebäudereinigung',
  description:
    'Professionelle Unterhalts-, Grund-, Bauschluss- und Treppenhausreinigung für Privat- und Gewerbekunden in Kirn, Bad Kreuznach und Idar-Oberstein.',
  provider: { '@id': `${SITE_URL}/#organization` },
  areaServed: [
    { '@type': 'City', name: 'Kirn' },
    { '@type': 'City', name: 'Bad Kreuznach' },
    { '@type': 'City', name: 'Idar-Oberstein' },
    { '@type': 'City', name: 'Bad Sobernheim' },
    { '@type': 'AdministrativeArea', name: 'Rheinland-Pfalz' },
  ],
  url: PAGE_URL,
  image: `${SITE_URL}/projekte/WASWIRTUNReinigungservice.jpg`,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Reinigungsleistungen',
    itemListElement: included.map((i) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: i.h, description: i.p },
    })),
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${PAGE_URL}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Reinigungsservice in Kirn – Büro, Treppenhaus & Grundreinigung"
  description="Professioneller Reinigungsservice in Kirn, Bad Kreuznach und Idar-Oberstein: Unterhaltsreinigung, Grundreinigung, Bauschlussreinigung und Treppenhausreinigung für Privat- und Gewerbekunden. Festpreis, klare Reinigungspläne, dokumentierte Qualitätskontrolle."
  image="/projekte/WASWIRTUNReinigungservice.jpg"
  breadcrumbs={[
    { name: 'Start', url: '/' },
    { name: 'Dienstleistungen', url: '/dienstleistungen' },
    { name: 'Reinigungsservice', url: PAGE_PATH },
  ]}
  jsonLd={[serviceLd, faqLd]}
>
  <section class="pt-24 pb-12 md:pt-40 md:pb-20 px-6 md:px-24">
    <p class="text-brand font-bold uppercase tracking-[0.3em] mb-4 text-[10px] md:text-xs italic">Dienstleistung 01 · Reinigungsservice</p>
    <h1 class="text-[clamp(2rem,8vw,6.5rem)] font-black uppercase leading-[0.9] mb-6 md:mb-8 text-[#0d1b2a]">
      Reinigungsservice<br />
      <span class="stroke-dark">in Kirn & Umgebung.</span>
    </h1>
    <p class="text-lg md:text-2xl text-slate-600 font-medium leading-relaxed max-w-3xl">
      Professionelle Unterhalts- und Grundreinigung für Büro-, Gewerbe- und Wohnobjekte in Kirn, Bad Kreuznach und Idar-Oberstein. Strukturiert, dokumentiert und mit klarem Festpreis.
    </p>
  </section>

  <section class="px-6 md:px-24 py-12 md:py-20 bg-slate-50 border-y border-slate-100">
    <div class="grid md:grid-cols-12 gap-8 md:gap-16">
      <div class="md:col-span-4">
        <p class="text-[10px] md:text-xs font-bold uppercase tracking-widest text-brand italic mb-2">Was Sie erhalten</p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-black uppercase leading-[0.95] text-[#0d1b2a]">Sauberkeit nach System.</h2>
      </div>
      <div class="md:col-span-8 space-y-5 text-base md:text-lg text-slate-600 font-medium leading-relaxed max-w-3xl">
        <p>
          Saubere Räume sind kein Zufall. Sie sind das Ergebnis strukturierter Arbeit, eingesetzter Erfahrung und konsequenter Qualitätskontrolle. Genau das liefert <strong class="text-[#0d1b2a]">Attar Dienstleistungen</strong> als professioneller Reinigungsdienst aus Kirn – mit festen Reinigungsplänen, geschultem Personal und transparenten Preisen.
        </p>
        <p>
          Wir reinigen Büroflächen, Praxen, Gewerbeobjekte, Treppenhäuser sowie Privatwohnungen und Häuser. Egal ob wiederkehrende Unterhaltsreinigung, einmalige Grundreinigung oder Sonderreinigung nach Bauphase, Auszug oder Wasserschaden: Sie erhalten ein Reinigungsergebnis, das Sie objektiv kontrollieren können – und das zu einem Preis, der vorher feststeht.
        </p>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-24 py-16 md:py-24">
    <p class="text-[10px] md:text-xs font-bold uppercase tracking-widest text-brand italic mb-3">Leistungen im Detail</p>
    <h2 class="text-3xl md:text-5xl font-black uppercase mb-10 md:mb-14 text-[#0d1b2a] max-w-3xl">Diese Reinigungen führen wir aus.</h2>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {included.map((i, idx) => (
        <div class="bg-white border border-slate-200 p-6 md:p-8 hover:border-brand transition-colors">
          <p class="text-brand font-black italic text-3xl md:text-4xl leading-none mb-4">0{idx + 1}</p>
          <h3 class="text-base md:text-lg font-black uppercase mb-3 text-[#0d1b2a] leading-tight">{i.h}</h3>
          <p class="text-sm text-slate-600 font-medium leading-relaxed">{i.p}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="px-6 md:px-24 py-16 md:py-24 bg-[#0d1b2a] text-white">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16">
      <div class="md:col-span-4">
        <p class="text-brand text-[10px] md:text-xs font-bold uppercase tracking-widest italic mb-3">Für wen</p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-black uppercase leading-[0.95]">Privat, Gewerbe, Hausverwaltung.</h2>
      </div>
      <div class="md:col-span-8 grid sm:grid-cols-2 gap-6 md:gap-8 text-slate-300">
        <div>
          <p class="text-brand font-black italic text-2xl mb-2 leading-none">Privatkunden</p>
          <p class="text-sm md:text-base font-medium leading-relaxed">Wohnungs- und Hausreinigung, Endreinigung bei Auszug, regelmäßige Pflege oder einmalige Grundreinigung – auf Wunsch mit Fensterputz und Treppenhaus.</p>
        </div>
        <div>
          <p class="text-brand font-black italic text-2xl mb-2 leading-none">Gewerbe</p>
          <p class="text-sm md:text-base font-medium leading-relaxed">Büros, Praxen, Kanzleien, Ladenflächen und Produktionsstandorte. Reinigung außerhalb der Geschäftszeiten ist möglich.</p>
        </div>
        <div>
          <p class="text-brand font-black italic text-2xl mb-2 leading-none">Hausverwaltungen</p>
          <p class="text-sm md:text-base font-medium leading-relaxed">Treppenhausreinigung, WEG-Pflege, Eingangsbereiche und Außenanlagen. Zuverlässig, dokumentiert, mit klarer Ansprechperson.</p>
        </div>
        <div>
          <p class="text-brand font-black italic text-2xl mb-2 leading-none">Bauträger & Handwerk</p>
          <p class="text-sm md:text-base font-medium leading-relaxed">Bauschluss- und Bauendreinigung nach Sanierungen, Renovierungen oder Neubauten. Übergabefertig inklusive Fenster.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-24 py-16 md:py-24">
    <p class="text-[10px] md:text-xs font-bold uppercase tracking-widest text-brand italic mb-3">Ablauf</p>
    <h2 class="text-3xl md:text-5xl font-black uppercase mb-10 md:mb-14 text-[#0d1b2a] max-w-3xl">So arbeiten wir.</h2>

    <div class="grid md:grid-cols-4 gap-8 md:gap-6 border-t border-slate-200 pt-10">
      {process.map((step) => (
        <div class="md:border-r md:last:border-r-0 md:border-slate-200 md:pr-6">
          <p class="text-brand font-black italic text-5xl md:text-6xl mb-4 leading-none">{step.n}</p>
          <h3 class="text-lg md:text-xl font-black uppercase mb-3 text-[#0d1b2a] leading-tight">{step.h}</h3>
          <p class="text-sm text-slate-600 font-medium leading-relaxed">{step.p}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="px-6 md:px-24 py-16 md:py-24 bg-slate-50">
    <div class="grid md:grid-cols-12 gap-8 md:gap-16">
      <div class="md:col-span-4">
        <p class="text-brand text-[10px] md:text-xs font-bold uppercase tracking-widest italic mb-3">Einsatzgebiet</p>
        <h2 class="text-3xl md:text-4xl font-black uppercase leading-[0.95] text-[#0d1b2a]">Wo wir reinigen.</h2>
      </div>
      <div class="md:col-span-8">
        <p class="text-base md:text-lg text-slate-600 font-medium leading-relaxed mb-6 max-w-2xl">
          Wir sind in Kirn beheimatet und arbeiten im gesamten Landkreis Bad Kreuznach sowie umliegenden Regionen. Größere Aufträge übernehmen wir auf Anfrage auch darüber hinaus.
        </p>
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs md:text-sm font-bold uppercase tracking-wider text-[#0d1b2a]">
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-brand rounded-full"></span>Kirn</li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-brand rounded-full"></span>Bad Kreuznach</li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-brand rounded-full"></span>Idar-Oberstein</li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-brand rounded-full"></span>Bad Sobernheim</li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-brand rounded-full"></span>Simmertal</li>
          <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-brand rounded-full"></span>Meisenheim</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-24 py-16 md:py-24">
    <p class="text-[10px] md:text-xs font-bold uppercase tracking-widest text-brand italic mb-3">Häufige Fragen</p>
    <h2 class="text-3xl md:text-5xl font-black uppercase mb-10 md:mb-14 text-[#0d1b2a] max-w-3xl">FAQ – Reinigungsservice.</h2>

    <div class="divide-y divide-slate-200 border-y border-slate-200 max-w-4xl">
      {faqs.map((f) => (
        <details class="group py-5 md:py-6">
          <summary class="flex justify-between items-center cursor-pointer list-none gap-6">
            <h3 class="text-base md:text-lg font-black uppercase text-[#0d1b2a] leading-snug">{f.q}</h3>
            <span class="text-brand font-black text-2xl shrink-0 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="text-sm md:text-base text-slate-600 font-medium leading-relaxed mt-4 max-w-3xl">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="px-6 md:px-24 py-16 md:py-24 bg-[#0d1b2a] text-white">
    <div class="max-w-4xl">
      <h2 class="text-3xl md:text-5xl font-black uppercase mb-4 md:mb-6 leading-tight">
        Ihr Objekt verdient<br />
        <span class="text-brand">saubere Arbeit.</span>
      </h2>
      <p class="text-slate-300 mb-8 md:mb-10 max-w-2xl text-base md:text-lg font-medium leading-relaxed">
        Beschreiben Sie uns Ihre Anforderungen – wir melden uns innerhalb von 24 Stunden mit einem klaren Festpreis.
      </p>
      <a href="/kontakt?service=reinigung" class="inline-block bg-brand text-white px-8 py-4 md:px-12 md:py-5 text-sm font-black uppercase tracking-widest hover:bg-white hover:text-[#0d1b2a] transition-all">
        Reinigungsangebot anfragen
      </a>
    </div>
  </section>
</Layout>
