---
export const prerender = true;

import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import IndividualOfferCTA from '../components/IndividualOfferCTA.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import { getAllProjects } from '../data/projects';
import { serviceImages } from '../data/serviceImages';

const allProjects = getAllProjects();

const services = [
  {
    id: "1",
    title: "Reinigungsservice",
    slug: "reinigungsservice",
    subtitle: "Professionell & Zuverlässig",
    description: "Von der regelmäßigen Unterhaltsreinigung bis zur intensiven Spezialreinigung sorgen wir für hygienische, gepflegte und repräsentative Räumlichkeiten. Unsere Arbeitsweise ist strukturiert, zuverlässig und effizient – mit einem klaren Fokus auf Qualität.\n\nOb Büroflächen, Gewerbeobjekte oder private Immobilien – wir schaffen Sauberkeit, auf die Sie sich verlassen können.",
    bullets: [],
    tagline: "Attar Dienstleistungen – Präzision bis ins Detail.",
    serviceType: "CleaningService"
  },
  {
    id: "2",
    title: "Hausmeisterservice",
    slug: "hausmeisterservice",
    subtitle: "Verantwortung & Reaktionsschnelle",
    description: "Unser Hausmeisterservice steht für Verantwortung, schnelle Reaktionszeiten und professionelle Ausführung. Wir kümmern uns um die laufende Betreuung Ihrer Immobilie – effizient, vorausschauend und lösungsorientiert.\n\nOb Wohnanlage, Gewerbeobjekt oder Unternehmensstandort – wir sorgen für Ordnung, Funktionalität und ein gepflegtes Erscheinungsbild.",
    bullets: [],
    tagline: "Attar Dienstleistungen – Betreuung mit System.",
    serviceType: "PropertyMaintenance"
  },
  {
    id: "3",
    title: "Umzugsservice",
    slug: "umzugsservice",
    subtitle: "Struktur, Planung & Erfahrung",
    description: "Wir begleiten Ihren Umzug professionell, effizient und zuverlässig. Ob privat oder gewerblich – wir sorgen für einen sicheren Transport, eine klare Organisation und eine stressfreie Umsetzung.",
    bullets: ["Sorgfalt im Detail.", "Struktur in der Planung.", "Zuverlässigkeit in der Ausführung."],
    tagline: "Attar Dienstleistungen – Wir bringen Sie sicher ans Ziel.",
    serviceType: "MovingCompany"
  },
  {
    id: "4",
    title: "Gartenservice",
    slug: "gartenservice",
    subtitle: "Gepflegt & Nachhaltig",
    description: "Unser Gartenservice steht für professionelle Pflege, saubere Ausführung und termingerechte Umsetzung. Wir kümmern uns um Ihre Außenanlagen mit Sorgfalt, Effizienz und Verantwortung.",
    bullets: ["Strukturiert in der Planung.", "Präzise in der Ausführung.", "Nachhaltig im Ergebnis."],
    tagline: "Attar Dienstleistungen – Qualität bis ins Grüne.",
    serviceType: "GardeningService"
  }
];

const SITE_URL = 'https://attardienstleistungen.com';

const serviceItemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${SITE_URL}/dienstleistungen#services`,
  name: 'Dienstleistungen von Attar Dienstleistungen',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: services.length,
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE_URL}/dienstleistungen/${s.slug}`,
    item: {
      '@type': 'Service',
      '@id': `${SITE_URL}/dienstleistungen/${s.slug}#service`,
      name: s.title,
      serviceType: s.serviceType,
      description: s.description.replace(/\n\n/g, ' '),
      provider: { '@id': `${SITE_URL}/#organization` },
      areaServed: [
        { '@type': 'City', name: 'Kirn' },
        { '@type': 'City', name: 'Bad Kreuznach' },
        { '@type': 'City', name: 'Idar-Oberstein' },
        { '@type': 'AdministrativeArea', name: 'Rheinland-Pfalz' },
      ],
      image: new URL(serviceImages[s.slug].src, SITE_URL).href,
      url: `${SITE_URL}/dienstleistungen/${s.slug}`,
    },
  })),
};
---

<Layout
  title="Dienstleistungen in Kirn – Reinigung, Hausmeister, Umzug, Garten"
  description="Unsere Leistungen im Überblick: Reinigungsservice, Hausmeisterservice, Umzugsservice und Gartenservice in Kirn und Umgebung. Professionell, strukturiert und zuverlässig für Privat- und Gewerbekunden."
  breadcrumbs={[
    { name: 'Start', url: '/' },
    { name: 'Dienstleistungen', url: '/dienstleistungen' },
  ]}
  jsonLd={serviceItemListLd}
>
  <section class="pt-24 pb-12 md:pt-40 md:pb-20 px-6 md:px-24">
    <p class="text-brand font-bold uppercase tracking-[0.3em] mb-4 text-[10px] md:text-xs italic">Portfolio</p>
    <h1 class="text-[clamp(1.6rem,7vw,6rem)] font-black uppercase leading-[0.9] mb-8">
      Unsere <br />
      <span class="stroke-black">Dienstleistungen</span>
    </h1>
  </section>

  <section class="pb-20 md:pb-32 px-6 md:px-24">
    <div class="flex flex-col gap-16 md:gap-32">
      {services.map((service, index) => (
        <div id={service.slug} class="grid md:grid-cols-12 gap-8 md:gap-16 items-center scroll-mt-24">

          <div class={`order-2 md:col-span-5 ${index % 2 !== 0 ? 'md:order-2 md:col-start-8' : 'md:order-1'}`}>
            <div class="relative">
              <span class="text-5xl md:text-7xl font-black text-slate-100 block mb-2 md:mb-4 italic leading-none select-none">
                0{index + 1}
              </span>

              <div class="relative z-10">
                <p class="text-brand font-bold uppercase tracking-widest text-[9px] md:text-[10px] mb-2">
                  {service.subtitle}
                </p>

                <h2 class="text-2xl md:text-4xl lg:text-5xl font-black uppercase mb-4 md:mb-6 tracking-tighter leading-[1.1]">
                  <a href={`/dienstleistungen/${service.slug}`} class="hover:text-brand transition-colors">{service.title}</a>
                </h2>

                <div class="text-sm md:text-base text-slate-600 font-medium leading-relaxed mb-4 md:mb-6 max-w-prose space-y-3">
                  {service.description.split('\n\n').map((para) => (
                    <p>{para}</p>
                  ))}
                </div>

                {service.bullets.length > 0 && (
                  <ul class="mb-4 md:mb-6 space-y-1">
                    {service.bullets.map((b) => (
                      <li class="flex items-center gap-2 text-sm font-bold text-[#0d1b2a]">
                        <span class="w-1.5 h-1.5 bg-brand rounded-full shrink-0"></span>
                        {b}
                      </li>
                    ))}
                  </ul>
                )}

                <p class="text-xs font-black italic text-[#0d1b2a] mb-6 md:mb-8">{service.tagline}</p>

                <div class="flex flex-wrap gap-x-8 gap-y-4 items-center">
                  <a href={`/dienstleistungen/${service.slug}`} class="group inline-flex items-center gap-3 bg-brand text-white px-6 py-3 md:px-8 md:py-4 text-[10px] md:text-xs font-black uppercase tracking-widest hover:bg-[#0d1b2a] transition-colors">
                    Mehr erfahren
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                  <a href={`/kontakt?service=${service.slug.replace('service', '')}`} class="group inline-flex items-center gap-3 border-b-2 border-[#0d1b2a] pb-1 text-[10px] md:text-xs font-black uppercase tracking-widest text-[#0d1b2a] hover:text-brand hover:border-brand transition-all">
                    Jetzt anfragen
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <a
            href={`/dienstleistungen/${service.slug}`}
            class={`order-1 md:col-span-7 overflow-hidden bg-slate-100 aspect-[4/3] md:aspect-video block group ${index % 2 !== 0 ? 'md:order-1 md:col-start-1' : 'md:order-2'}`}
            aria-label={`${service.title} – Details ansehen`}
          >
            <Image
              src={serviceImages[service.slug]}
              alt={`${service.title} von Attar Dienstleistungen in Kirn`}
              widths={[600, 900, 1200]}
              sizes="(min-width: 768px) 58vw, 100vw"
              class="w-full h-full object-cover transition-transform duration-[1.5s] ease-out group-hover:scale-110"
              loading="lazy"
            />
          </a>

        </div>
      ))}
    </div>
  </section>

  <ProjectGallery
    projects={allProjects}
    eyebrow="Referenzen"
    heading="Ausgewählte Projekte."
    intro="Ein Auszug aus unseren letzten Aufträgen in Kirn und Umgebung. Klicken Sie auf ein Projekt, um die komplette Fotostrecke zu sehen."
  />

  <IndividualOfferCTA />
</Layout>
