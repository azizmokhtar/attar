---
import '../styles/global.css';
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';
import CookieConsent from '../components/CookieConsent.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface BreadcrumbItem {
	name: string;
	url: string;
}

interface Props {
	title: string;
	description?: string;
	image?: string;
	ogType?: 'website' | 'article' | 'profile';
	noindex?: boolean;
	canonical?: string;
	breadcrumbs?: BreadcrumbItem[];
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	preloadHeroPoster?: boolean;
}

const {
	title,
	description = 'Attar Dienstleistungen aus Kirn (Rheinland-Pfalz): Reinigungsservice, Hausmeisterservice, Umzugsservice und Gartenservice. Zuverlässig, strukturiert und mit klarem Qualitätsanspruch – jetzt unverbindliches Angebot anfragen.',
	image = '/og-default.jpg',
	ogType = 'website',
	noindex = false,
	canonical,
	breadcrumbs,
	jsonLd,
	preloadHeroPoster = false,
} = Astro.props;

const GA_ID = 'G-1QJF32TBF3';
const SITE_URL = 'https://attar-dienstleistungen.de';
const SITE_NAME = 'Attar Dienstleistungen';
const COMPANY_PHONE_E164 = '+4917655235870';
const COMPANY_PHONE_DISPLAY = '+49 176 55235870';
const COMPANY_EMAIL = 'attar.dienstleistungen@gmail.com';

const pageUrl = canonical ?? (new URL(Astro.url.pathname, SITE_URL).href.replace(/\/$/, '') || SITE_URL);
const ogImageUrl = new URL(image, SITE_URL).href;
const fullTitle = `${title} | ${SITE_NAME}`;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

const organizationLd = {
	'@context': 'https://schema.org',
	'@type': ['Organization', 'LocalBusiness', 'ProfessionalService'],
	'@id': `${SITE_URL}/#organization`,
	name: SITE_NAME,
	legalName: 'Attar Dienstleistungen – Adam Attar',
	url: SITE_URL,
	logo: {
		'@type': 'ImageObject',
		url: `${SITE_URL}/logo.png`,
		width: 368,
		height: 120,
	},
	image: `${SITE_URL}/og-default.jpg`,
	telephone: COMPANY_PHONE_E164,
	email: COMPANY_EMAIL,
	founder: { '@type': 'Person', name: 'Adam Attar' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Nachtigallenweg 10',
		postalCode: '55606',
		addressLocality: 'Kirn',
		addressRegion: 'Rheinland-Pfalz',
		addressCountry: 'DE',
	},
	areaServed: [
		{ '@type': 'City', name: 'Kirn' },
		{ '@type': 'City', name: 'Bad Kreuznach' },
		{ '@type': 'City', name: 'Idar-Oberstein' },
		{ '@type': 'City', name: 'Bad Sobernheim' },
		{ '@type': 'AdministrativeArea', name: 'Rheinland-Pfalz' },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '20:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '08:30',
			closes: '18:00',
		},
	],
	contactPoint: {
		'@type': 'ContactPoint',
		telephone: COMPANY_PHONE_E164,
		email: COMPANY_EMAIL,
		contactType: 'customer service',
		availableLanguage: ['de', 'en'],
		areaServed: 'DE',
	},
};

const websiteLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${SITE_URL}/#website`,
	url: SITE_URL,
	name: SITE_NAME,
	inLanguage: 'de-DE',
	publisher: { '@id': `${SITE_URL}/#organization` },
};

const breadcrumbLd = breadcrumbs && breadcrumbs.length > 0
	? {
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: breadcrumbs.map((b, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: b.name,
			item: new URL(b.url, SITE_URL).href,
		})),
	}
	: null;

const extraJsonLd = jsonLd
	? (Array.isArray(jsonLd) ? jsonLd : [jsonLd])
	: [];
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={pageUrl} />
		{noindex
			? <>
				<meta name="robots" content="noindex,follow" />
				<meta name="googlebot" content="noindex,follow" />
			</>
			: <>
				<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
				<meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1" />
			</>
		}

		<meta name="theme-color" content="#0d1b2a" />
		<meta name="apple-mobile-web-app-title" content="Attar" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="author" content="Attar Dienstleistungen" />
		<meta name="publisher" content="Attar Dienstleistungen" />
		<meta name="geo.region" content="DE-RP" />
		<meta name="geo.placename" content="Kirn" />
		<meta name="geo.position" content="49.7869;7.4581" />
		<meta name="ICBM" content="49.7869, 7.4581" />

		{/* Open Graph */}
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${SITE_NAME} – ${title}`} />
		<meta property="og:locale" content="de_DE" />

		{/* Twitter Card */}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={`${SITE_NAME} – ${title}`} />

		<link rel="alternate" hreflang="de-DE" href={pageUrl} />
		<link rel="alternate" hreflang="x-default" href={pageUrl} />

		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
		<link rel="shortcut icon" type="image/png" href="/favicon-32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
		<link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
		{preloadHeroPoster && <link rel="preload" as="image" href="/main-poster.jpg" fetchpriority="high" />}

		{/* JSON-LD: global Organization + WebSite */}
		<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationLd)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)} />
		{breadcrumbLd && (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
		)}
		{extraJsonLd.map((node) => (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(node)} />
		))}

		{/* Google Consent Mode v2 — must run BEFORE gtag.js loads. */}
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){ dataLayer.push(arguments); }
			gtag('consent', 'default', {
				ad_storage: 'denied',
				ad_user_data: 'denied',
				ad_personalization: 'denied',
				analytics_storage: 'denied',
				functionality_storage: 'denied',
				personalization_storage: 'denied',
				security_storage: 'granted',
				wait_for_update: 500,
			});
		</script>
		<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
		<script is:inline define:vars={{ GA_ID }}>
			gtag('js', new Date());
			gtag('config', GA_ID, { anonymize_ip: true });
		</script>
	</head>
	<body class="bg-white text-slate-900 selection:bg-brand selection:text-white">
		<div class="fixed inset-0 flex justify-between px-8 md:px-24 pointer-events-none -z-10" aria-hidden="true">
    <div class="border-r border-dashed border-slate-200 h-full"></div>
    <div class="border-r border-dashed border-slate-200 h-full hidden md:block"></div>
    <div class="border-r border-dashed border-slate-200 h-full hidden md:block"></div>
    <div class="border-r border-dashed border-slate-200 h-full"></div>
</div>

	<nav class="sticky top-0 z-[1001] flex justify-between items-center px-6 py-5 md:px-24 xl:py-6 2xl:py-7 bg-white/90 backdrop-blur-md border-b border-slate-100/80">
    	<a href="/" class="relative z-[110] block">
        <img
            src="/logo.png"
            alt="Attar Dienstleistungen Logo"
            width="368"
            height="120"
            decoding="async"
            fetchpriority="high"
            class="h-8 md:h-10 xl:h-12 2xl:h-14 w-auto object-contain"
        />
    </a>
      <button id="menu-button" class="md:hidden relative z-[1110] flex flex-col gap-1.5 p-2" aria-label="Menü öffnen">
        <span class="w-6 h-0.5 bg-black transition-all duration-300" id="line1"></span>
        <span class="w-6 h-0.5 bg-black transition-all duration-300" id="line2"></span>
        <span class="w-6 h-0.5 bg-black transition-all duration-300" id="line3"></span>
    </button>

    <div class="hidden md:flex items-center gap-8 xl:gap-10 2xl:gap-12">
    <a href="/dienstleistungen" class="text-xs xl:text-sm 2xl:text-base font-bold uppercase tracking-widest hover:text-brand transition-colors">Dienstleistungen</a>
    <a href="/ueber-uns" class="text-xs xl:text-sm 2xl:text-base font-bold uppercase tracking-widest hover:text-brand transition-colors">Über uns</a>
    <a href="/blog" class="text-xs xl:text-sm 2xl:text-base font-bold uppercase tracking-widest hover:text-brand transition-colors">Ratgeber</a>
    <a href="/karriere" class="text-xs xl:text-sm 2xl:text-base font-bold uppercase tracking-widest hover:text-brand transition-colors">Karriere</a>
    <a href="/kontakt" class="bg-[#0d1b2a] text-white px-5 py-2.5 xl:px-6 xl:py-3 2xl:px-7 2xl:py-3.5 text-xs xl:text-sm 2xl:text-base font-bold uppercase tracking-widest hover:bg-brand transition-colors">Kontakt</a>
</div>

</nav>

<script>
    const btn = document.getElementById('menu-button');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('menu-overlay');
    const line1 = document.getElementById('line1');
    const line2 = document.getElementById('line2');
    const line3 = document.getElementById('line3');

    function toggleMenu() {
    const isOpen = sidebar?.classList.contains('translate-x-0');

    if (!isOpen) {
        sidebar?.classList.remove('invisible');
        sidebar?.classList.replace('translate-x-full', 'translate-x-0');
        overlay?.classList.replace('opacity-0', 'opacity-100');
        overlay?.classList.replace('pointer-events-none', 'pointer-events-auto');

        line1.style.transform = 'translateY(8px) rotate(45deg)';
        line2.style.opacity = '0';
        line3.style.transform = 'translateY(-8px) rotate(-45deg)';
        document.body.style.overflow = 'hidden';
    } else {
        sidebar?.classList.replace('translate-x-0', 'translate-x-full');
        overlay?.classList.replace('opacity-100', 'opacity-0');
        overlay?.classList.replace('pointer-events-auto', 'pointer-events-none');

        setTimeout(() => {
            if (sidebar?.classList.contains('translate-x-full')) {
                sidebar?.classList.add('invisible');
            }
        }, 500);

        line1.style.transform = 'none';
        line2.style.opacity = '1';
        line3.style.transform = 'none';
        document.body.style.overflow = '';
    }
}

    btn?.addEventListener('click', toggleMenu);
    overlay?.addEventListener('click', toggleMenu);
</script>
		<main>
			<slot />
		</main>
    <div id="menu-overlay" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[998] opacity-0 pointer-events-none transition-opacity duration-300"></div>

    <div id="sidebar" class="fixed top-0 right-0 w-[80%] max-w-[400px] h-full bg-white z-[999] translate-x-full invisible transition-all duration-500 ease-in-out p-10 md:p-12 flex flex-col">
    <div class="mt-24 flex flex-col gap-6">
        <p class="text-brand font-bold uppercase tracking-widest text-[9px]">Navigation</p>

        <a href="/dienstleistungen" class="text-2xl md:text-3xl font-black uppercase italic hover:text-brand transition-colors">Dienstleistungen</a>
        <a href="/ueber-uns" class="text-2xl md:text-3xl font-black uppercase italic hover:text-brand transition-colors">Über uns</a>
        <a href="/blog" class="text-2xl md:text-3xl font-black uppercase italic hover:text-brand transition-colors">Ratgeber</a>
        <a href="/karriere" class="text-2xl md:text-3xl font-black uppercase italic hover:text-brand transition-colors">Karriere</a>

        <div class="h-px bg-slate-100 my-4"></div>

        <a href="/kontakt" class="text-2xl md:text-3xl font-black uppercase italic text-brand">Kontakt</a>
    </div>

    <div class="mt-auto space-y-2">
        <p class="text-xs font-bold text-slate-500">{COMPANY_PHONE_DISPLAY}</p>
        <p class="text-[9px] font-bold uppercase text-slate-400">© 2026 Attar Dienstleistungen</p>
    </div>
</div>


		<footer class="relative z-10 bg-[#0d1b2a] text-slate-300 border-t border-white/5 px-6 md:px-24 pt-16 md:pt-24 pb-10 md:pb-12 overflow-hidden">
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-12 gap-10 md:gap-8">

    <div class="sm:col-span-2 md:col-span-4">
      <h2 class="text-3xl md:text-4xl font-black tracking-tighter mb-4 text-white italic">ATTAR.</h2>
      <p class="text-xs font-bold uppercase tracking-widest leading-relaxed text-slate-400 max-w-[280px]">
        Präzision in der Ausführung.<br/> Verlässlichkeit im Service.
      </p>
    </div>

    <div class="md:col-span-2">
      <p class="text-[10px] font-bold uppercase text-brand mb-5 tracking-[0.2em]">Navigation</p>
      <ul class="flex flex-col gap-3 text-xs font-bold uppercase tracking-widest text-slate-300">
        <li><a href="/dienstleistungen" class="hover:text-brand transition-colors">Dienstleistungen</a></li>
        <li><a href="/ueber-uns" class="hover:text-brand transition-colors">Über uns</a></li>
        <li><a href="/blog" class="hover:text-brand transition-colors">Ratgeber</a></li>
        <li><a href="/karriere" class="hover:text-brand transition-colors">Karriere</a></li>
        <li><a href="/kontakt" class="hover:text-brand transition-colors">Angebot anfragen</a></li>
      </ul>
    </div>

    <div class="md:col-span-3">
      <p class="text-[10px] font-bold uppercase text-brand mb-5 tracking-[0.2em]">Kontakt</p>
      <div class="flex flex-col gap-5">
        <a href={`tel:${COMPANY_PHONE_E164}`} class="group">
          <p class="text-[9px] font-bold text-slate-500 uppercase mb-1">Telefon</p>
          <p class="text-xs font-black text-white group-hover:text-brand transition-colors uppercase tracking-wider">{COMPANY_PHONE_DISPLAY}</p>
        </a>
        <a href="mailto:attar.dienstleistungen@gmail.com" class="group">
          <p class="text-[9px] font-bold text-slate-500 uppercase mb-1">E-Mail</p>
          <p class="text-[11px] font-black text-white group-hover:text-brand transition-colors lowercase">attar.dienstleistungen@gmail.com</p>
        </a>
        <div>
          <p class="text-[9px] font-bold text-slate-500 uppercase mb-1">Bürozeiten</p>
          <p class="text-[10px] font-bold text-slate-300 uppercase leading-relaxed">Mo – Fr: 07:00 – 20:00<br/>Sa: 08:30 – 18:00</p>
        </div>
      </div>
    </div>

    <div class="md:col-span-3 text-slate-300">
      <p class="text-[10px] font-bold uppercase text-brand mb-5 tracking-[0.2em]">Standort</p>
      <address class="not-italic text-xs font-bold uppercase tracking-widest leading-loose">
        Attar Dienstleistungen<br />
        55606 Kirn<br/>
        Rheinland-Pfalz
      </address>
    </div>
  </div>

  <div class="mt-16 md:mt-24 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-slate-500">
    <div class="flex flex-wrap gap-6 text-[9px] font-bold uppercase tracking-[0.1em]">
      <a href="/impressum" class="hover:text-white transition-colors">Impressum</a>
      <a href="/datenschutz" class="hover:text-white transition-colors">Datenschutz</a>
      <a href="/agb" class="hover:text-white transition-colors">AGB</a>
      <button type="button" data-consent-action="reopen" class="hover:text-white transition-colors uppercase tracking-[0.1em] cursor-pointer">Cookie-Einstellungen</button>
    </div>

    <p class="text-[9px] font-bold uppercase tracking-[0.1em] text-center">
      © 2026 Attar Dienstleistungen. Alle Rechte vorbehalten.
    </p>

    <div>
      <a href="mailto:mohamedazizelmokhtar27@gmail.com" class="text-[9px] hover:text-brand transition-colors lowercase text-slate-600">Developed by mohamedazizelmokhtar27@gmail.com</a>
    </div>
  </div>
</footer>

	<SpeedInsights />
	<Analytics />
	<WhatsAppButton />
	<CookieConsent />
	</body>
</html>
